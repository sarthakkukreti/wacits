# CITS WhatsApp Communication Manager — environment configuration
# Per PRD §3.4 (TS-8): the application must refuse to start if any required
# secret is missing. Never commit the real .env file.

# --- Database (PostgreSQL 16+) ---
# For local dev against a directly-installed Postgres (the RUNBOOK's
# default flow), DATABASE_URL is all that matters and POSTGRES_* below are
# unused. For docker-compose, POSTGRES_* configure the postgres container
# and DATABASE_URL is overridden per-service in docker-compose.yml to point
# at it — set POSTGRES_PASSWORD to a real secret before running compose
# anywhere but a throwaway environment; there is no default.
DATABASE_URL=postgres://localhost:5432/wacits_dev
POSTGRES_USER=wacits
POSTGRES_PASSWORD=
POSTGRES_DB=wacits

# --- Queue datastore (Valkey; Redis is wire-compatible for local dev) ---
REDIS_URL=redis://localhost:6379

# --- Meta WhatsApp Cloud API ---
# Business system user token for CITS's own WABA (see PRD Appendix B).
# Per-client sender-number tokens are stored encrypted in the database
# (access_token table), never in environment variables.
META_SYSTEM_USER_TOKEN=
# App Secret, used to verify the X-Hub-Signature-256 header on every
# inbound webhook (PRD AR-6). Never log this value.
META_APP_SECRET=
# Arbitrary string Meta echoes back during the webhook verification
# handshake (PRD AR-12).
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Token encryption at rest ---
# Envelope-encryption key for the access_token table. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Error tracking ---
SENTRY_DSN=

# --- Ports (local dev only; containers use fixed internal ports) ---
API_PORT=8787
WEBHOOK_PORT=8788
WEB_PORT=3000
CLICK_REDIRECT_PORT=8789

# --- API base URL, called by the web app's server components ---
# Local dev: the API running directly on your machine.
# Hostinger deployment: the backend's public HTTPS URL, e.g.
#   https://api.wacits.cyberlative.com
# This is a real cross-host HTTP call in production (see RUNBOOK.md "Split
# hosting"), not same-network container traffic — set it in Hostinger's
# Node.js App environment variables (or a bundled .env.production, see
# RUNBOOK) to the real backend URL, never localhost.
API_BASE_URL=http://localhost:8787

# --- CORS ---
# The API now serves requests from a different host than the web app (split
# hosting), so it must explicitly allow the frontend's origin. Set to the
# exact scheme+host the browser/Next.js server calls from — no trailing
# slash, no wildcard in production.
CORS_ORIGIN=https://wacits.cyberlative.com

# --- Backend public domain (production only, informational) ---
# Not read by anything at runtime — the actual hostname lives in the
# Traefik labels on the `caddy` service in docker-compose.yml (Coolify's
# own Traefik proxy owns TLS/routing for this domain; see RUNBOOK.md
# "Split hosting" for why the per-service Domain UI field is deliberately
# left empty). Documented here purely so the right hostname is easy to
# find. Must be a real DNS A/AAAA record pointing at the VPS — deliberately
# a DIFFERENT hostname than the web app's, since they now live on different
# servers.
API_PUBLIC_DOMAIN=api.wacits.cyberlative.com
