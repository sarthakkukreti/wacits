# Passenger/LiteSpeed wiring for the dashboard on Hostinger.
#
# Hostinger creates the Node app but does NOT write these directives itself —
# without them Apache serves the (index-less) git checkout and returns 403.
# The document root IS the repo checkout, so postinstall copies this file to
# <docroot>/.htaccess on every deploy (see scripts/hostinger-postinstall.mjs),
# keeping it durable rather than a one-off hand edit that a redeploy could drop.
#
# The absolute path is fixed for this account/domain; if the app ever moves,
# update PassengerAppRoot and PassengerRestartDir together.
PassengerAppRoot /home/u310526385/domains/wacits.cyberlative.com/public_html
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs22/root/bin/node
PassengerStartupFile apps/web/.next/standalone/server.js
PassengerBaseURI /
PassengerRestartDir /home/u310526385/domains/wacits.cyberlative.com/public_html/tmp
SetEnv LSNODE_CONSOLE_LOG console.log

RewriteEngine On

# Serve /_next/static/* straight from disk instead of routing it through the
# app. Requests for these reliably 404'd through Passenger for one specific
# Next-internal chunk even though the file existed and a restart didn't help
# (see prepare-standalone.sh, which is what writes apps/web/_next/static).
# Rewriting to an existing file hands the request to Apache's own static
# file handling — Passenger only steps in when the resolved path doesn't
# exist on disk — so this sidesteps the app's own static handling entirely.
RewriteRule ^_next/static/(.*)$ apps/web/_next/static/$1 [L]

# The document root is the repo checkout, so refuse to serve anything that must
# never be public even if Passenger falls through to static handling.
RewriteRule ^\.builds - [F,L]
RewriteRule ^\.git - [F,L]
RewriteRule ^\.env - [F,L]
RewriteRule ^(docker-compose|Caddyfile|bun\.lock|package-lock\.json|tsconfig) - [F,L]
