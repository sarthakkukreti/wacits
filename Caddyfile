# Internal path-based router for the CITS WhatsApp Communication Manager
# backend — NOT the public TLS edge. The VPS is managed by Coolify, which
# already runs its own Traefik proxy owning ports 80/443 and terminating
# HTTPS for every app on the box (see RUNBOOK.md "Split hosting"). Coolify
# is told to route api.wacits.cyberlative.com to this container's port 80;
# it forwards plain HTTP here, which is why this listens on a bare `:80`
# rather than a domain name — a domain-name site address is what tells
# Caddy to attempt its own Let's Encrypt certificate via ACME, which would
# be redundant with (and would fight) Coolify's own certificate for the
# same domain. Don't reintroduce a domain-name site block here without
# also removing this from behind Coolify's proxy.
#
# Split hosting: the Next.js web app is deployed separately on Hostinger
# shared hosting and is NOT behind this proxy. This Caddyfile only fronts
# the backend — API, webhook receiver, click-redirect.
#
# Click-tracking links (/c/*) live on this same backend domain rather than
# a dedicated domain of their own — a deliberate compromise since only this
# one backend subdomain exists today (PRD §16 would prefer a clean domain
# for click-through reputation; revisit if that becomes a real concern).

:80 {
	# Meta's webhook callback URL is https://api.wacits.cyberlative.com/webhook
	# — strip the /webhook prefix before forwarding, since the webhook
	# receiver itself listens on "/" (see apps/webhook/src/index.ts).
	handle_path /webhook* {
		reverse_proxy webhook:8788
	}

	# Click-tracking redirects: https://api.wacits.cyberlative.com/c/<token>
	# — do NOT strip the prefix here, the click-redirect app's own route is
	# "/c/:token" (see apps/click-redirect/src/index.ts).
	handle /c/* {
		reverse_proxy click-redirect:8789
	}

	# Everything else is the API, called cross-origin by the Next.js app
	# running on Hostinger (see CORS_ORIGIN in apps/api/src/index.ts).
	handle {
		reverse_proxy api:8787
	}

	encode gzip
	log {
		output stdout
		format json
	}
}
